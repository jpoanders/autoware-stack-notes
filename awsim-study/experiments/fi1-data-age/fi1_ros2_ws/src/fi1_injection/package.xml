<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fi1_injection</name>
  <version>0.0.0</version>
  <description>FI1 (Data Age Violation) Path A injector: an rclpy node that replays old
  VelocityReport data with new timestamps (stuck sensor) to exercise the SEU.</description>
  <maintainer email="jpoanders@gmail.com">janders</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>autoware_vehicle_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
